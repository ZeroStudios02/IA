# Copia este archivo a .env para desarrollo local
# Genera tu clave gratuita en https://aistudio.google.com/apikey
GEMINI_API_KEY=tu_api_key_aqui

# Modelo por defecto (puedes cambiarlo por otro de la familia Gemini)
GEMINI_MODEL=gemini-2.5-flash

# Opcionales
# TEMPERATURE=0.8
# MAX_OUTPUT_TOKENS=4096
# RATE_LIMIT_PER_MIN=30
# SYSTEM_PROMPT=Eres "IA", un asistente útil y amable...
